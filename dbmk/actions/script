#!/bin/sh

# Description
# -----------------------------------
# Opens or creates actions
# $1 - The filename of the action to create/delete
# -----------------------------------

# Config
# -----------------------------------
terminal="kitty"
text_editor="nvim"
# -----------------------------------

action_path="$1"
touch $action_path
chmod +x "$action_path"

$terminal -e $text_editor "$action_path"
